# Public challenge build. The WebMCP surface does not require credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Client-IP header trust for per-visitor rate limiting. Leave unset to
# auto-detect (trusted on Vercel, untrusted elsewhere). Set true only behind
# a reverse proxy that rewrites x-forwarded-for; explicit false collapses
# all visitors into one shared rate-limit bucket.
WEATHER_TRUST_PROXY_HEADERS=

# Optional Ask Elijah Lite house guide. Keep this key server-only.
OPENAI_API_KEY=
ASK_OPENAI_MODEL=gpt-5.6-luna

# Same trust rule as WEATHER_TRUST_PROXY_HEADERS, for the Ask route.
ASK_TRUST_PROXY_HEADERS=

# Per-instance safety cap; provider project budgets remain the hard backstop.
ASK_GLOBAL_HOURLY_CAP=120
