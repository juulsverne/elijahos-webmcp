/media-src/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
output/
/public/kb/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# docs — internal strategy/working notes, not part of the public release
docs/WEBMCP_JUDGE_STRATEGY.md
docs/webmcp-demo-video-script.md
docs/webmcp-finish-runbook.md
docs/superpowers/plans/2026-09-03-target-evidence-worksheet.md

