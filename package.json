{
  "name": "elijahos-webmcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--conditions=react-server tsx --test \"src/**/*.test.ts\"",
    "check:ui": "node scripts/check-ui-contract.mjs",
    "test:responsive": "cross-env NO_COLOR= playwright test tests/responsive.spec.ts",
    "build:icons": "node scripts/build-icons.mjs",
    "build:public-index": "tsx scripts/build-public-index.ts",
    "check:public-index": "tsx scripts/build-public-index.ts --check",
    "build:export-manifest": "node scripts/build-export-manifest.mjs",
    "check:export-manifest": "node scripts/build-export-manifest.mjs --check",
    "verify": "npm run lint && npm run typecheck && npm test && npm run check:ui && npm run check:public-index && npm run check:export-manifest",
    "test:webmcp": "cross-env NO_COLOR= playwright test tests/webmcp.spec.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "9.6.1",
    "clsx": "^2.1.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "three": "0.182.0",
    "zustand": "5.0.13"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.182.0",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "sharp": "0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.4",
    "typescript": "^5"
  }
}
